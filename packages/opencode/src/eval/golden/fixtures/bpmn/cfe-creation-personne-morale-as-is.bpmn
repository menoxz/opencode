<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_CFE_CreationPersonneMorale_AS-IS"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_CFE_CreationPersonneMorale">

    <bpmn:participant id="Participant_Promoteur" name="Promoteur de l'entreprise" processRef="Process_Promoteur" />
    <bpmn:participant id="Participant_CFE" name="Centre de Formalités des Entreprises (CFE)" processRef="Process_CFE" />
    <bpmn:participant id="Participant_OTR" name="OTR - Office Togolais des Recettes" processRef="Process_OTR" />
    <bpmn:participant id="Participant_RCCM" name="RCCM - Registre du Commerce et du Crédit Mobilier" processRef="Process_RCCM" />

    <bpmn:messageFlow id="MF1_DepotDossier" name="Dossier + paiement" sourceRef="Task_DeposerDemande" targetRef="Start_CFE_ReceptionDossier" />
    <bpmn:messageFlow id="MF2_DemandeNIF" name="Demande NIF" sourceRef="Task_DemanderNIF" targetRef="Start_OTR" />
    <bpmn:messageFlow id="MF3_RetourNIF" name="NIF attribué" sourceRef="Task_AttribuerNIF" targetRef="Event_ReceptionNIF" />
    <bpmn:messageFlow id="MF4_DemandeImmatriculation" name="Demande immatriculation" sourceRef="Task_DemanderImmatriculation" targetRef="Start_RCCM" />
    <bpmn:messageFlow id="MF5_RetourImmatriculation" name="Immatriculation confirmée" sourceRef="Task_ImmatriculerRCCM" targetRef="Event_ReceptionImmatriculation" />
    <bpmn:messageFlow id="MF6_Notification" name="Notification par email" sourceRef="Task_NotifierDemandeur" targetRef="Event_AttenteNotification" />

  </bpmn:collaboration>

  <!-- ================= POOL 1 : PROMOTEUR ================= -->
  <bpmn:process id="Process_Promoteur" isExecutable="false">

    <bpmn:startEvent id="Start_Promoteur" name="Besoin de créer une société">
      <bpmn:outgoing>SF1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ConstituerDossier" name="Constituer le dossier">
      <bpmn:documentation>Questionnaire de déclaration de création d'entreprise personne morale ; pièce d'identité du dirigeant ; titre de séjour/visa pour les étrangers ; déclaration sur l'honneur de non-condamnation ; statuts de la société ; photo d'identité du dirigeant ; plan de situation du siège social ; acte de mariage si applicable.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF1</bpmn:incoming>
      <bpmn:outgoing>SF2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_DeposerDemande" name="Déposer la demande et payer">
      <bpmn:documentation>Dépôt sur la plateforme du CFE (cfetogo.tg). Frais : 28 250 FCFA (nationaux/CEDEAO) ou 33 250 FCFA (étrangers hors CEDEAO), paiement en ligne.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF2</bpmn:incoming>
      <bpmn:outgoing>SF3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_AttenteNotification" name="Attendre la notification">
      <bpmn:incoming>SF3</bpmn:incoming>
      <bpmn:outgoing>SF4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_AttenteNotification" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_TelechargerDocuments" name="Télécharger les documents">
      <bpmn:documentation>Documents délivrés : attestation d'immatriculation au RCCM, NIF, statuts enregistrés. Durée de validité de l'immatriculation : illimitée.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF4</bpmn:incoming>
      <bpmn:outgoing>SF5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Promoteur" name="Société créée">
      <bpmn:incoming>SF5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF1" sourceRef="Start_Promoteur" targetRef="Task_ConstituerDossier" />
    <bpmn:sequenceFlow id="SF2" sourceRef="Task_ConstituerDossier" targetRef="Task_DeposerDemande" />
    <bpmn:sequenceFlow id="SF3" sourceRef="Task_DeposerDemande" targetRef="Event_AttenteNotification" />
    <bpmn:sequenceFlow id="SF4" sourceRef="Event_AttenteNotification" targetRef="Task_TelechargerDocuments" />
    <bpmn:sequenceFlow id="SF5" sourceRef="Task_TelechargerDocuments" targetRef="End_Promoteur" />

  </bpmn:process>

  <!-- ================= POOL 2 : CFE ================= -->
  <bpmn:process id="Process_CFE" isExecutable="false">

    <bpmn:startEvent id="Start_CFE_ReceptionDossier" name="Réception du dossier">
      <bpmn:outgoing>SF6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_ReceptionDossier" />
    </bpmn:startEvent>

    <bpmn:userTask id="Task_VerifierRaisonSociale" name="Vérifier la raison sociale">
      <bpmn:documentation>Vérification de la disponibilité et de la conformité de la raison sociale. Erreur fréquente : raison sociale non conforme.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF6</bpmn:incoming>
      <bpmn:outgoing>SF7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ControlerPieces" name="Contrôler les pièces">
      <bpmn:documentation>Contrôle de conformité des pièces justificatives. Frictions fréquentes : dossiers incomplets ou non conformes, pièces d'identité expirées, photos non conformes, documents scannés illisibles.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF7</bpmn:incoming>
      <bpmn:outgoing>SF8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_IntegrerDossier" name="Intégrer le dossier">
      <bpmn:documentation>Saisie du dossier dans l'application métier interne du CFE.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF8</bpmn:incoming>
      <bpmn:outgoing>SF9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_DemanderNIF" name="Demander le NIF à l'OTR">
      <bpmn:documentation>Interconnexion avec le système de l'OTR pour l'attribution du Numéro d'Identification Fiscale. Point de friction récurrent : indisponibilités techniques de l'interconnexion OTR.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF9</bpmn:incoming>
      <bpmn:outgoing>SF10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_ReceptionNIF" name="Recevoir le NIF">
      <bpmn:incoming>SF10</bpmn:incoming>
      <bpmn:outgoing>SF11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_ReceptionNIF" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_ValiderDossier" name="Valider le dossier">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF11</bpmn:incoming>
      <bpmn:outgoing>SF12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_DemanderImmatriculation" name="Demander l'immatriculation">
      <bpmn:documentation>Transmission du dossier validé au RCCM en vue de l'immatriculation.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF12</bpmn:incoming>
      <bpmn:outgoing>SF13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_ReceptionImmatriculation" name="Recevoir l'immatriculation">
      <bpmn:incoming>SF13</bpmn:incoming>
      <bpmn:outgoing>SF14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_ReceptionImmatriculation" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_PublierAnnonces" name="Publier les annonces légales">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF14</bpmn:incoming>
      <bpmn:outgoing>SF15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_NotifierDemandeur" name="Notifier le demandeur">
      <bpmn:documentation>Notification du demandeur par courrier électronique.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF15</bpmn:incoming>
      <bpmn:outgoing>SF16</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_CFE" name="Dossier traité">
      <bpmn:incoming>SF16</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF6" sourceRef="Start_CFE_ReceptionDossier" targetRef="Task_VerifierRaisonSociale" />
    <bpmn:sequenceFlow id="SF7" sourceRef="Task_VerifierRaisonSociale" targetRef="Task_ControlerPieces" />
    <bpmn:sequenceFlow id="SF8" sourceRef="Task_ControlerPieces" targetRef="Task_IntegrerDossier" />
    <bpmn:sequenceFlow id="SF9" sourceRef="Task_IntegrerDossier" targetRef="Task_DemanderNIF" />
    <bpmn:sequenceFlow id="SF10" sourceRef="Task_DemanderNIF" targetRef="Event_ReceptionNIF" />
    <bpmn:sequenceFlow id="SF11" sourceRef="Event_ReceptionNIF" targetRef="Task_ValiderDossier" />
    <bpmn:sequenceFlow id="SF12" sourceRef="Task_ValiderDossier" targetRef="Task_DemanderImmatriculation" />
    <bpmn:sequenceFlow id="SF13" sourceRef="Task_DemanderImmatriculation" targetRef="Event_ReceptionImmatriculation" />
    <bpmn:sequenceFlow id="SF14" sourceRef="Event_ReceptionImmatriculation" targetRef="Task_PublierAnnonces" />
    <bpmn:sequenceFlow id="SF15" sourceRef="Task_PublierAnnonces" targetRef="Task_NotifierDemandeur" />
    <bpmn:sequenceFlow id="SF16" sourceRef="Task_NotifierDemandeur" targetRef="End_CFE" />

  </bpmn:process>

  <!-- ================= POOL 3 : OTR ================= -->
  <bpmn:process id="Process_OTR" isExecutable="false">

    <bpmn:startEvent id="Start_OTR" name="Réception demande NIF">
      <bpmn:outgoing>SF17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Start_OTR" />
    </bpmn:startEvent>

    <bpmn:userTask id="Task_AttribuerNIF" name="Attribuer le NIF">
      <bpmn:documentation>Attribution du Numéro d'Identification Fiscale via interconnexion automatisée avec l'application métier du CFE. Sujette à des indisponibilités techniques.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF17</bpmn:incoming>
      <bpmn:outgoing>SF18</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_OTR" name="NIF transmis">
      <bpmn:incoming>SF18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF17" sourceRef="Start_OTR" targetRef="Task_AttribuerNIF" />
    <bpmn:sequenceFlow id="SF18" sourceRef="Task_AttribuerNIF" targetRef="End_OTR" />

  </bpmn:process>

  <!-- ================= POOL 4 : RCCM ================= -->
  <bpmn:process id="Process_RCCM" isExecutable="false">

    <bpmn:startEvent id="Start_RCCM" name="Réception demande immatriculation">
      <bpmn:outgoing>SF19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Start_RCCM" />
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ImmatriculerRCCM" name="Immatriculer la société">
      <bpmn:documentation>Immatriculation au Registre du Commerce et du Crédit Mobilier. Document produit : attestation d'immatriculation au RCCM.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF19</bpmn:incoming>
      <bpmn:outgoing>SF20</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_RCCM" name="Immatriculation transmise">
      <bpmn:incoming>SF20</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF19" sourceRef="Start_RCCM" targetRef="Task_ImmatriculerRCCM" />
    <bpmn:sequenceFlow id="SF20" sourceRef="Task_ImmatriculerRCCM" targetRef="End_RCCM" />

  </bpmn:process>

  <!-- ================= DIAGRAM ================= -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_CFE_CreationPersonneMorale">

      <!-- Pool 1 : Promoteur -->
      <bpmndi:BPMNShape id="Shape_Participant_Promoteur" bpmnElement="Participant_Promoteur" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1500" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Promoteur" bpmnElement="Start_Promoteur">
        <dc:Bounds x="200" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ConstituerDossier" bpmnElement="Task_ConstituerDossier">
        <dc:Bounds x="290" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DeposerDemande" bpmnElement="Task_DeposerDemande">
        <dc:Bounds x="440" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_AttenteNotification" bpmnElement="Event_AttenteNotification">
        <dc:Bounds x="1240" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_TelechargerDocuments" bpmnElement="Task_TelechargerDocuments">
        <dc:Bounds x="1330" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Promoteur" bpmnElement="End_Promoteur">
        <dc:Bounds x="1500" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Pool 2 : CFE -->
      <bpmndi:BPMNShape id="Shape_Participant_CFE" bpmnElement="Participant_CFE" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="1500" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_CFE_ReceptionDossier" bpmnElement="Start_CFE_ReceptionDossier">
        <dc:Bounds x="200" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_VerifierRaisonSociale" bpmnElement="Task_VerifierRaisonSociale">
        <dc:Bounds x="280" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ControlerPieces" bpmnElement="Task_ControlerPieces">
        <dc:Bounds x="440" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IntegrerDossier" bpmnElement="Task_IntegrerDossier">
        <dc:Bounds x="600" y="260" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DemanderNIF" bpmnElement="Task_DemanderNIF">
        <dc:Bounds x="750" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_ReceptionNIF" bpmnElement="Event_ReceptionNIF">
        <dc:Bounds x="912" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValiderDossier" bpmnElement="Task_ValiderDossier">
        <dc:Bounds x="990" y="260" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DemanderImmatriculation" bpmnElement="Task_DemanderImmatriculation">
        <dc:Bounds x="1140" y="260" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_ReceptionImmatriculation" bpmnElement="Event_ReceptionImmatriculation">
        <dc:Bounds x="1312" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PublierAnnonces" bpmnElement="Task_PublierAnnonces">
        <dc:Bounds x="1390" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_NotifierDemandeur" bpmnElement="Task_NotifierDemandeur">
        <dc:Bounds x="1550" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_CFE" bpmnElement="End_CFE">
        <dc:Bounds x="1610" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Pool 3 : OTR -->
      <bpmndi:BPMNShape id="Shape_Participant_OTR" bpmnElement="Participant_OTR" isHorizontal="true">
        <dc:Bounds x="160" y="400" width="1500" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_OTR" bpmnElement="Start_OTR">
        <dc:Bounds x="770" y="452" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AttribuerNIF" bpmnElement="Task_AttribuerNIF">
        <dc:Bounds x="850" y="430" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_OTR" bpmnElement="End_OTR">
        <dc:Bounds x="1010" y="452" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Pool 4 : RCCM -->
      <bpmndi:BPMNShape id="Shape_Participant_RCCM" bpmnElement="Participant_RCCM" isHorizontal="true">
        <dc:Bounds x="160" y="570" width="1500" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_RCCM" bpmnElement="Start_RCCM">
        <dc:Bounds x="1160" y="622" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ImmatriculerRCCM" bpmnElement="Task_ImmatriculerRCCM">
        <dc:Bounds x="1240" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_RCCM" bpmnElement="End_RCCM">
        <dc:Bounds x="1400" y="622" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Sequence flow edges : Promoteur -->
      <bpmndi:BPMNEdge id="Edge_SF1" bpmnElement="SF1">
        <di:waypoint x="236" y="130" /><di:waypoint x="290" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF2" bpmnElement="SF2">
        <di:waypoint x="390" y="130" /><di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF3" bpmnElement="SF3">
        <di:waypoint x="560" y="130" /><di:waypoint x="1240" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF4" bpmnElement="SF4">
        <di:waypoint x="1276" y="130" /><di:waypoint x="1330" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF5" bpmnElement="SF5">
        <di:waypoint x="1450" y="130" /><di:waypoint x="1500" y="130" />
      </bpmndi:BPMNEdge>

      <!-- Sequence flow edges : CFE -->
      <bpmndi:BPMNEdge id="Edge_SF6" bpmnElement="SF6">
        <di:waypoint x="236" y="300" /><di:waypoint x="280" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF7" bpmnElement="SF7">
        <di:waypoint x="400" y="300" /><di:waypoint x="440" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF8" bpmnElement="SF8">
        <di:waypoint x="560" y="300" /><di:waypoint x="600" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF9" bpmnElement="SF9">
        <di:waypoint x="710" y="300" /><di:waypoint x="750" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF10" bpmnElement="SF10">
        <di:waypoint x="870" y="300" /><di:waypoint x="912" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF11" bpmnElement="SF11">
        <di:waypoint x="948" y="300" /><di:waypoint x="990" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF12" bpmnElement="SF12">
        <di:waypoint x="1100" y="300" /><di:waypoint x="1140" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF13" bpmnElement="SF13">
        <di:waypoint x="1270" y="300" /><di:waypoint x="1312" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF14" bpmnElement="SF14">
        <di:waypoint x="1348" y="300" /><di:waypoint x="1390" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF15" bpmnElement="SF15">
        <di:waypoint x="1510" y="300" /><di:waypoint x="1550" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF16" bpmnElement="SF16">
        <di:waypoint x="1670" y="300" /><di:waypoint x="1610" y="300" />
      </bpmndi:BPMNEdge>

      <!-- Sequence flow edges : OTR -->
      <bpmndi:BPMNEdge id="Edge_SF17" bpmnElement="SF17">
        <di:waypoint x="806" y="470" /><di:waypoint x="850" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF18" bpmnElement="SF18">
        <di:waypoint x="970" y="470" /><di:waypoint x="1010" y="470" />
      </bpmndi:BPMNEdge>

      <!-- Sequence flow edges : RCCM -->
      <bpmndi:BPMNEdge id="Edge_SF19" bpmnElement="SF19">
        <di:waypoint x="1196" y="640" /><di:waypoint x="1240" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF20" bpmnElement="SF20">
        <di:waypoint x="1360" y="640" /><di:waypoint x="1400" y="640" />
