<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ccfcc_exportateur_v2" targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Web Modeler" exporterVersion="f51c130"
  modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">

  <bpmn:collaboration id="Collaboration_CCFCC_v2">
    <bpmn:participant id="Participant_Demandeur" name="Demandeur (promoteur d'entreprise)"
      processRef="Process_Demandeur" />
    <bpmn:participant id="Participant_CCFCC"
      name="CCFCC - Comité de Coordination Filières Café Cacao"
      processRef="Process_CCFCC" />
    <bpmn:participant id="Participant_DCP" name="DCP"
      processRef="Process_DCP" />
    <bpmn:participant id="Participant_CECC"
      name="CECC - Conseil des Exportateurs de Café et Cacao"
      processRef="Process_CECC" />
    <bpmn:participant id="Participant_MinistereCom" name="Ministère de la Communication"
      processRef="Process_MinistereCom" />

    <!-- Cross-pool exchanges: messageFlow only, never sequenceFlow -->
    <bpmn:messageFlow id="MF_DepotDossier" name="Dépôt du dossier"
      sourceRef="Task_Dem_DeposerDossier" targetRef="Event_CCFCC_ReceptionDossier" />
    <bpmn:messageFlow id="MF_NotifierIncomplet" name="Dossier incomplet"
      sourceRef="Task_CCFCC_NotifierIncomplet" targetRef="Event_Dem_ReceptionNotifIncomplet" />
    <bpmn:messageFlow id="MF_RedeposerDossier" name="Dossier complété"
      sourceRef="Task_Dem_CompleterDossier" targetRef="Event_CCFCC_ReceptionComplement" />
    <bpmn:messageFlow id="MF_NotifierComplet" name="Dossier complet"
      sourceRef="Task_CCFCC_NotifierComplet" targetRef="Event_Dem_ReceptionNotifComplet" />
    <bpmn:messageFlow id="MF_SoumettreDCP" name="Demande DCP"
      sourceRef="Task_Dem_SoumettreDCP" targetRef="Event_DCP_ReceptionDemande" />
    <bpmn:messageFlow id="MF_RemiseAttestationDCP" name="Attestation DCP"
      sourceRef="Task_DCP_DelivrerAttestation" targetRef="Event_Dem_ReceptionAttestationDCP" />
    <bpmn:messageFlow id="MF_EnregistrerCECC" name="Enregistrement CECC"
      sourceRef="Task_Dem_EnregistrerCECC" targetRef="Event_CECC_ReceptionEnregistrement" />
    <bpmn:messageFlow id="MF_Paiement" name="Paiement 500 000 FCFA"
      sourceRef="Task_Dem_Payer" targetRef="Event_CCFCC_ReceptionPaiement" />
    <bpmn:messageFlow id="MF_EnvoiCommuniqueMinistere" name="Communiqué"
      sourceRef="Task_CCFCC_EnvoyerCommunique" targetRef="Event_Ministere_ReceptionCommunique" />
    <bpmn:messageFlow id="MF_EnvoiListeCECC" name="Copie de la liste"
      sourceRef="Task_CCFCC_EnvoyerCommunique" targetRef="Event_CECC_ReceptionListe" />
    <bpmn:messageFlow id="MF_NotificationFinale" name="Notification exportateur"
      sourceRef="Task_CECC_InformerExportateurs" targetRef="Event_Dem_ReceptionNotificationFinale" />
  </bpmn:collaboration>

  <!-- ============================================================ -->
  <!-- POOL 1 - Demandeur (externe, promoteur d'entreprise)          -->
  <!-- ============================================================ -->
  <bpmn:process id="Process_Demandeur" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Vouloir exporter café/cacao">
      <bpmn:outgoing>SF1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Dem_ComposerDossier" name="Composer le dossier">
      <bpmn:documentation>Statut entreprise, siège social, capital social, n° carte autorisation, n° RCCM, n° opérateur économique.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF1</bpmn:incoming>
      <bpmn:outgoing>SF2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Dem_DeposerDossier" name="Déposer le dossier">
      <bpmn:documentation>Dépôt au secrétariat du CCFCC (présentiel) ou par mail (plateforme).</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF2</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_Dem_ReceptionNotifIncomplet" name="Recevoir avis incomplet">
      <bpmn:outgoing>SF3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_notifIncomplet" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Dem_CompleterDossier" name="Compléter le dossier">
      <bpmn:documentation>Délai supplémentaire de 2 semaines accordé chaque année (ex. jusqu'au 23/08/2026).</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF3</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_Dem_ReceptionNotifComplet" name="Recevoir avis complet">
      <bpmn:outgoing>SF4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_notifComplet" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Dem_SoumettreDCP" name="Soumettre une demande à la DCP">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF4</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_Dem_ReceptionAttestationDCP" name="Recevoir l'attestation DCP">
      <bpmn:outgoing>SF5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_attestationDCP" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Dem_IntegrerAttestation" name="Intégrer l'attestation">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF5</bpmn:incoming>
      <bpmn:outgoing>SF6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Dem_EnregistrerCECC" name="S'enregistrer au CECC">
      <bpmn:documentation>Renouvellement annuel obligatoire.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF6</bpmn:incoming>
      <bpmn:outgoing>SF7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Dem_Payer" name="Payer 500 000 FCFA">
      <bpmn:documentation>Paiement à la caisse du CCFCC.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF7</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_Dem_ReceptionNotificationFinale" name="Recevoir la notification">
      <bpmn:outgoing>SF8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_notifFinale" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Dem_RecupererAttestation" name="Récupérer l'attestation">
      <bpmn:documentation>Attestation d'enregistrement, retirée physiquement au CCFCC.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF8</bpmn:incoming>
      <bpmn:outgoing>SF9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Dem" name="Exportateur enregistré">
      <bpmn:incoming>SF9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF1" sourceRef="StartEvent_1" targetRef="Task_Dem_ComposerDossier" />
    <bpmn:sequenceFlow id="SF2" sourceRef="Task_Dem_ComposerDossier" targetRef="Task_Dem_DeposerDossier" />
    <bpmn:sequenceFlow id="SF3" sourceRef="Event_Dem_ReceptionNotifIncomplet" targetRef="Task_Dem_CompleterDossier" />
    <bpmn:sequenceFlow id="SF4" sourceRef="Event_Dem_ReceptionNotifComplet" targetRef="Task_Dem_SoumettreDCP" />
    <bpmn:sequenceFlow id="SF5" sourceRef="Event_Dem_ReceptionAttestationDCP" targetRef="Task_Dem_IntegrerAttestation" />
    <bpmn:sequenceFlow id="SF6" sourceRef="Task_Dem_IntegrerAttestation" targetRef="Task_Dem_EnregistrerCECC" />
    <bpmn:sequenceFlow id="SF7" sourceRef="Task_Dem_EnregistrerCECC" targetRef="Task_Dem_Payer" />
    <bpmn:sequenceFlow id="SF8" sourceRef="Event_Dem_ReceptionNotificationFinale" targetRef="Task_Dem_RecupererAttestation" />
    <bpmn:sequenceFlow id="SF9" sourceRef="Task_Dem_RecupererAttestation" targetRef="EndEvent_Dem" />

  </bpmn:process>

  <!-- ============================================================ -->
  <!-- POOL 2 - CCFCC (3 lanes = même chaîne hiérarchique interne)   -->
  <!-- ============================================================ -->
  <bpmn:process id="Process_CCFCC" isExecutable="true">

    <bpmn:laneSet id="LaneSet_CCFCC">
      <bpmn:lane id="Lane_Secretariat" name="Secrétariat CCFCC">
        <bpmn:flowNodeRef>Event_CCFCC_ReceptionDossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CCFCC_VerifierDossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DossierComplet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CCFCC_NotifierIncomplet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CCFCC_ReceptionComplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CCFCC_NotifierComplet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CCFCC_ReceptionPaiement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CCFCC_PercevoirPaiement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CCFCC_TransmettreDossier</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SecretariatGeneral" name="Secrétariat général">
        <bpmn:flowNodeRef>Task_CCFCC_AnnoterDossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CCFCC_ProduireCommunique</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CCFCC_EnvoyerCommunique</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_President" name="Président (Directeur cabinet Commerce)">
        <bpmn:flowNodeRef>Task_CCFCC_SignerCommunique</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:intermediateCatchEvent id="Event_CCFCC_ReceptionDossier" name="Recevoir le dossier">
      <bpmn:outgoing>SF10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_receptionDossier" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_CCFCC_VerifierDossier" name="Vérifier le dossier">
      <bpmn:documentation>Conformité et complétude. Rejets fréquents : pièces expirées, photos non conformes, documents illisibles, raison sociale non conforme.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF10</bpmn:incoming>
      <bpmn:incoming>SF12</bpmn:incoming>
      <bpmn:outgoing>SF11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DossierComplet" name="Dossier complet ?">
      <bpmn:incoming>SF11</bpmn:incoming>
      <bpmn:outgoing>SF_Non</bpmn:outgoing>
      <bpmn:outgoing>SF_Oui</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CCFCC_NotifierIncomplet" name="Notifier dossier incomplet">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF_Non</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_CCFCC_ReceptionComplement" name="Recevoir le complément">
      <bpmn:outgoing>SF12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_receptionComplement" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_CCFCC_NotifierComplet" name="Notifier dossier complet">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF_Oui</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_CCFCC_ReceptionPaiement" name="Recevoir le paiement">
      <bpmn:outgoing>SF13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_receptionPaiement" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_CCFCC_PercevoirPaiement" name="Délivrer un reçu">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF13</bpmn:incoming>
      <bpmn:outgoing>SF14</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CCFCC_TransmettreDossier" name="Transmettre au Sec. Général">
      <bpmn:documentation>Enregistrement du courrier avant transmission.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF14</bpmn:incoming>
      <bpmn:outgoing>SF15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CCFCC_AnnoterDossier" name="Annoter le dossier">
      <bpmn:documentation>Complète la liste des dossiers complets de l'année.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF15</bpmn:incoming>
      <bpmn:outgoing>SF16</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CCFCC_ProduireCommunique" name="Produire le communiqué">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF16</bpmn:incoming>
      <bpmn:outgoing>SF17</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CCFCC_SignerCommunique" name="Signer le communiqué">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF17</bpmn:incoming>
      <bpmn:outgoing>SF18</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CCFCC_EnvoyerCommunique" name="Envoyer le communiqué">
      <bpmn:documentation>Envoi au Ministère de la Communication (diffusion) et copie de la liste au CECC (information des exportateurs).</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF18</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="SF10" sourceRef="Event_CCFCC_ReceptionDossier" targetRef="Task_CCFCC_VerifierDossier" />
    <bpmn:sequenceFlow id="SF11" sourceRef="Task_CCFCC_VerifierDossier" targetRef="Gateway_DossierComplet" />
    <bpmn:sequenceFlow id="SF_Non" name="Non" sourceRef="Gateway_DossierComplet" targetRef="Task_CCFCC_NotifierIncomplet" />
    <bpmn:sequenceFlow id="SF_Oui" name="Oui" sourceRef="Gateway_DossierComplet" targetRef="Task_CCFCC_NotifierComplet" />
    <bpmn:sequenceFlow id="SF12" sourceRef="Event_CCFCC_ReceptionComplement" targetRef="Task_CCFCC_VerifierDossier" />
    <bpmn:sequenceFlow id="SF13" sourceRef="Event_CCFCC_ReceptionPaiement" targetRef="Task_CCFCC_PercevoirPaiement" />
    <bpmn:sequenceFlow id="SF14" sourceRef="Task_CCFCC_PercevoirPaiement" targetRef="Task_CCFCC_TransmettreDossier" />
    <bpmn:sequenceFlow id="SF15" sourceRef="Task_CCFCC_TransmettreDossier" targetRef="Task_CCFCC_AnnoterDossier" />
    <bpmn:sequenceFlow id="SF16" sourceRef="Task_CCFCC_AnnoterDossier" targetRef="Task_CCFCC_ProduireCommunique" />
    <bpmn:sequenceFlow id="SF17" sourceRef="Task_CCFCC_ProduireCommunique" targetRef="Task_CCFCC_SignerCommunique" />
    <bpmn:sequenceFlow id="SF18" sourceRef="Task_CCFCC_SignerCommunique" targetRef="Task_CCFCC_EnvoyerCommunique" />

    <bpmn:textAnnotation id="Annotation_DelaisDepasse">
      <bpmn:text>Point de friction : les usagers déposent souvent en retard, obligeant le CCFCC à prolonger le délai de 2 semaines chaque année.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_DelaisDepasse"
      sourceRef="Gateway_DossierComplet" targetRef="Annotation_DelaisDepasse" />

  </bpmn:process>

  <!-- ============================================================ -->
  <!-- POOL 3 - DCP (organisme public distinct)                       -->
  <!-- ============================================================ -->
  <bpmn:process id="Process_DCP" isExecutable="true">

    <bpmn:intermediateCatchEvent id="Event_DCP_ReceptionDemande" name="Recevoir la demande">
      <bpmn:outgoing>SF19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_receptionDemandeDCP" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_DCP_VerifierInfra" name="Vérifier les infrastructures">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF19</bpmn:incoming>
      <bpmn:outgoing>SF20</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_DCP_DelivrerAttestation" name="Délivrer l'attestation">
      <bpmn:documentation>Attestation des moyens d'exercice de la profession.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF20</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="SF19" sourceRef="Event_DCP_ReceptionDemande" targetRef="Task_DCP_VerifierInfra" />
    <bpmn:sequenceFlow id="SF20" sourceRef="Task_DCP_VerifierInfra" targetRef="Task_DCP_DelivrerAttestation" />

  </bpmn:process>

  <!-- ============================================================ -->
  <!-- POOL 4 - CECC (organisme public distinct)                      -->
  <!-- ============================================================ -->
  <bpmn:process id="Process_CECC" isExecutable="true">

    <bpmn:intermediateCatchEvent id="Event_CECC_ReceptionEnregistrement" name="Recevoir la demande">
      <bpmn:outgoing>SF21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_receptionEnregistrementCECC" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_CECC_EnregistrerExportateur" name="Enregistrer l'exportateur">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF21</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_CECC_ReceptionListe" name="Recevoir la liste">
      <bpmn:outgoing>SF22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_receptionListeCECC" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_CECC_InformerExportateurs" name="Informer les exportateurs">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF22</bpmn:incoming>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="SF21" sourceRef="Event_CECC_ReceptionEnregistrement" targetRef="Task_CECC_EnregistrerExportateur" />
    <bpmn:sequenceFlow id="SF22" sourceRef="Event_CECC_ReceptionListe" targetRef="Task_CECC_InformerExportateurs" />

  </bpmn:process>

  <!-- ============================================================ -->
  <!-- POOL 5 - Ministère de la Communication (organisme distinct)    -->
  <!-- ============================================================ -->
  <bpmn:process id="Process_MinistereCom" isExecutable="true">

    <bpmn:intermediateCatchEvent id="Event_Ministere_ReceptionCommunique" name="Recevoir le communiqué">
      <bpmn:outgoing>SF23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_receptionCommunique" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Ministere_DiffuserCommunique" name="Diffuser le communiqué">
      <bpmn:documentation>Publication de la liste des exportateurs enregistrés.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF23</bpmn:incoming>
      <bpmn:outgoing>SF24</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Ministere" name="Communiqué diffusé">
      <bpmn:incoming>SF24</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF23" sourceRef="Event_Ministere_ReceptionCommunique" targetRef="Task_Ministere_DiffuserCommunique" />
    <bpmn:sequenceFlow id="SF24" sourceRef="Task_Ministere_DiffuserCommunique" targetRef="EndEvent_Ministere" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_CCFCC_v2">

      <!-- Pool 1: Demandeur -->
      <bpmndi:BPMNShape id="Participant_Demandeur_di" bpmnElement="Participant_Demandeur" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="2700" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="200" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="180" y="155" width="76" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Dem_ComposerDossier_di" bpmnElement="Task_Dem_ComposerDossier">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Dem_DeposerDossier_di" bpmnElement="Task_Dem_DeposerDossier">
        <dc:Bounds x="430" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Dem_ReceptionNotifIncomplet_di" bpmnElement="Event_Dem_ReceptionNotifIncomplet">
        <dc:Bounds x="580" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="558" y="155" width="80" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Dem_CompleterDossier_di" bpmnElement="Task_Dem_CompleterDossier">
        <dc:Bounds x="670" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Dem_ReceptionNotifComplet_di" bpmnElement="Event_Dem_ReceptionNotifComplet">
        <dc:Bounds x="820" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="798" y="155" width="80" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Dem_SoumettreDCP_di" bpmnElement="Task_Dem_SoumettreDCP">
        <dc:Bounds x="910" y="90" width="100" height="80" />
