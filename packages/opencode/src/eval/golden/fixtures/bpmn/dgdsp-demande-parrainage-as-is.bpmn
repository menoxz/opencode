<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dgdsp_parrainage" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="f51c130" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_dgdsp_parrainage">
    <bpmn:participant id="Participant_SG" name="Secrétariat Général" processRef="Process_SG" />
    <bpmn:participant id="Participant_DGDSP" name="DGDSP" processRef="Process_DGDSP" />
    <bpmn:participant id="Participant_AgentDelegue" name="Agent délégué (direction concernée)" processRef="Process_AgentDelegue" />
    <bpmn:participant id="Participant_Destinataire" name="Destinataire" processRef="Process_Destinataire" />

    <bpmn:messageFlow id="MF1" name="Courrier + fiche de transmission" sourceRef="Task_EnvoyerCourrierSG" targetRef="Event_ReceptionCourrierSecretariat" />
    <bpmn:messageFlow id="MF2" name="Courrier (navette physique)" sourceRef="Task_TransmettreNavetteAgentDelegue" targetRef="Event_ReceptionCourrierAgent" />
    <bpmn:messageFlow id="MF3" name="Réponse rédigée (navette)" sourceRef="Task_RedigerReponse" targetRef="Event_ReceptionReponseAgent" />
    <bpmn:messageFlow id="MF4" name="Demande de correction" sourceRef="Task_TransmettreCorrectionAgent" targetRef="Event_ReceptionDemandeCorrection" />
    <bpmn:messageFlow id="MF5" name="Réponse corrigée" sourceRef="Task_CorrigerReponse" targetRef="Event_ReceptionReponseCorrigee" />
    <bpmn:messageFlow id="MF6" name="Réponse paraphée (navette)" sourceRef="Task_TransmettreNavetteSG" targetRef="Event_ReceptionReponseParaphee_SG" />
    <bpmn:messageFlow id="MF7" name="Notification : dossier prêt" sourceRef="Task_ValiderDossierFinalSG" targetRef="Event_ReceptionNotificationDossierPret" />
    <bpmn:messageFlow id="MF8" name="Courrier de réponse" sourceRef="Task_TransmettreCourrierDestinataire" targetRef="Event_ReceptionCourrierDestinataire" />
    <bpmn:messageFlow id="MF9" name="Décharge signée (papier)" sourceRef="Task_SignerDecharge" targetRef="Event_ReceptionDecharge" />
  </bpmn:collaboration>

  <bpmn:process id="Process_SG" isExecutable="true">
    <bpmn:startEvent id="StartEvent_SG" name="Besoin d'orienter le courrier vers la DGDSP">
      <bpmn:outgoing>SF1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_EnvoyerCourrierSG" name="Envoyer le courrier et la fiche de transmission">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:documentation>Le Secrétariat Général envoie le courrier de l'usager (TPE/PME) et la fiche de transmission au format physique au secrétariat de la DGDSP.</bpmn:documentation>
      <bpmn:incoming>SF1</bpmn:incoming>
      <bpmn:outgoing>SF2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_ReceptionReponseParaphee_SG" name="Réception de la réponse paraphée">
      <bpmn:outgoing>SF3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_reponseParaphee" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_ValiderDossierFinalSG" name="Valider le dossier final et notifier la DGDSP">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:documentation>Le Secrétariat Général valide le dossier reçu (paraphe uniquement, dernier niveau non atteint côté DGDSP) puis notifie la DGDSP que le dossier final est prêt.</bpmn:documentation>
      <bpmn:incoming>SF3</bpmn:incoming>
      <bpmn:outgoing>SF4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_SG_Envoi">
      <bpmn:incoming>SF2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_SG">
      <bpmn:incoming>SF4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF1" sourceRef="StartEvent_SG" targetRef="Task_EnvoyerCourrierSG" />
    <bpmn:sequenceFlow id="SF2" sourceRef="Task_EnvoyerCourrierSG" targetRef="EndEvent_SG_Envoi" />
    <bpmn:sequenceFlow id="SF3" sourceRef="Event_ReceptionReponseParaphee_SG" targetRef="Task_ValiderDossierFinalSG" />
    <bpmn:sequenceFlow id="SF4" sourceRef="Task_ValiderDossierFinalSG" targetRef="EndEvent_SG" />
  </bpmn:process>

  <bpmn:process id="Process_DGDSP" isExecutable="true">
    <bpmn:laneSet id="LaneSet_DGDSP">
      <bpmn:lane id="Lane_Secretariat" name="Secrétariat DGDSP">
        <bpmn:flowNodeRef>Event_ReceptionCourrierSecretariat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnregistrerCourrierArrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmettreCourrierDG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendreSignatureDG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceptionnerCourrierSigne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnregistrerRegistreTransmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmettreNavetteAgentDelegue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendreReponseAgentDelegue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReceptionReponseAgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmettreReponseDG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmettreCorrectionAgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReceptionReponseCorrigee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendreParapheSignatureDG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceptionnerReponseParaphee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmettreNavetteSG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendreReponseSG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReceptionNotificationDossierPret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecupererCopieDossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClasserDossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Branche14_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecupererReponseSigneeParaphee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnregistrerDepartTransmettreCoursier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClasserDecharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Branche14_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Directeur" name="Directeur Général DGDSP">
        <bpmn:flowNodeRef>Task_RemplirFicheEtSigner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValiderOuCorriger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidationDG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ForkParapheSignature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ParapherSignerDG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TypeValidation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coursier" name="Coursier">
        <bpmn:flowNodeRef>Task_TransmettreCourrierDestinataire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendreDechargeCoursier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReceptionDecharge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:intermediateCatchEvent id="Event_ReceptionCourrierSecretariat" name="Réception du courrier du Secrétariat Général">
      <bpmn:outgoing>SF5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_courrierSG" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_EnregistrerCourrierArrive" name="Enregistrer le courrier dans le registre de courrier arrivé">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:documentation>Registre physique de courrier arrivé, tenu manuellement.</bpmn:documentation>
      <bpmn:incoming>SF5</bpmn:incoming>
      <bpmn:outgoing>SF6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TransmettreCourrierDG" name="Transmettre le courrier au DG">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF6</bpmn:incoming>
      <bpmn:outgoing>SF7</bpmn:outgoing>
      <bpmn:outgoing>SF8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RemplirFicheEtSigner" name="Remplir la fiche de correspondance (avec l'agent délégué) et signer">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:documentation>Le DG désigne l'agent délégué dans la direction concernée sur la fiche de correspondance papier et signe.</bpmn:documentation>
      <bpmn:incoming>SF7</bpmn:incoming>
      <bpmn:outgoing>SF9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AttendreSignatureDG" name="Attendre la signature du DG">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:documentation>Le secrétariat de la DGDSP patiente pendant que le DG remplit la fiche de correspondance et signe.</bpmn:documentation>
      <bpmn:incoming>SF8</bpmn:incoming>
      <bpmn:outgoing>SF10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReceptionnerCourrierSigne" name="Réceptionner le courrier et la fiche signés">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF9</bpmn:incoming>
      <bpmn:incoming>SF10</bpmn:incoming>
      <bpmn:outgoing>SF11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EnregistrerRegistreTransmission" name="Enregistrer le courrier dans le registre de transmission">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF11</bpmn:incoming>
      <bpmn:outgoing>SF12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TransmettreNavetteAgentDelegue" name="Transmettre le courrier par navette physique à l'agent délégué">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF12</bpmn:incoming>
      <bpmn:outgoing>SF13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AttendreReponseAgentDelegue" name="Attendre la réponse de l'agent délégué">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:documentation>Après avoir remis le courrier et signé le registre de transmission avec l'agent délégué, le secrétariat de la DGDSP attend la réponse rédigée.</bpmn:documentation>
      <bpmn:incoming>SF13</bpmn:incoming>
      <bpmn:outgoing>SF14</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_ReceptionReponseAgent" name="Réception de la réponse de l'agent délégué">
      <bpmn:outgoing>SF15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_reponseAgent" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_TransmettreReponseDG" name="Transmettre la réponse au DG">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF14</bpmn:incoming>
      <bpmn:incoming>SF15</bpmn:incoming>
      <bpmn:incoming>SF23</bpmn:incoming>
      <bpmn:outgoing>SF16</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ValiderOuCorriger" name="Valider la réponse ou suggérer des corrections">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF16</bpmn:incoming>
      <bpmn:outgoing>SF17</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ValidationDG" name="Correction nécessaire ?">
      <bpmn:incoming>SF17</bpmn:incoming>
      <bpmn:outgoing>SF18</bpmn:outgoing>
      <bpmn:outgoing>SF19</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_TransmettreCorrectionAgent" name="Transmettre la suggestion de correction à l'agent délégué">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF18</bpmn:incoming>
      <bpmn:outgoing>SF20</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_ReceptionReponseCorrigee" name="Réception de la réponse corrigée">
      <bpmn:outgoing>SF23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_reponseCorrigee" />
    </bpmn:intermediateCatchEvent>

    <bpmn:parallelGateway id="Gateway_ForkParapheSignature" name="Paraphe / signature en cours">
      <bpmn:incoming>SF19</bpmn:incoming>
      <bpmn:outgoing>SF21</bpmn:outgoing>
      <bpmn:outgoing>SF22</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_ParapherSignerDG" name="Parapher et/ou signer la réponse">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:documentation>Le DG signe si c'est le dernier niveau de validation, sinon paraphe uniquement (le Secrétariat Général devra valider).</bpmn:documentation>
      <bpmn:incoming>SF21</bpmn:incoming>
      <bpmn:outgoing>SF24</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AttendreParapheSignatureDG" name="Attendre le paraphe / la signature du DG">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF22</bpmn:incoming>
      <bpmn:outgoing>SF25</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReceptionnerReponseParaphee" name="Réceptionner la réponse paraphée et/ou signée">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF24</bpmn:incoming>
      <bpmn:incoming>SF25</bpmn:incoming>
      <bpmn:outgoing>SF26</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_TypeValidation" name="Paraphe uniquement (SG valide) ou signature finale ?">
      <bpmn:incoming>SF26</bpmn:incoming>
      <bpmn:outgoing>SF27</bpmn:outgoing>
      <bpmn:outgoing>SF28</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_TransmettreNavetteSG" name="Transmettre la réponse par navette au Secrétariat Général">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF27</bpmn:incoming>
      <bpmn:outgoing>SF29</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AttendreReponseSG" name="Attendre la réponse du Secrétariat Général">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF29</bpmn:incoming>
      <bpmn:outgoing>SF30</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_ReceptionNotificationDossierPret" name="Réception de la notification : dossier prêt">
      <bpmn:outgoing>SF31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_dossierPret" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_RecupererCopieDossier" name="Se déplacer pour récupérer la copie du dossier final">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF30</bpmn:incoming>
      <bpmn:incoming>SF31</bpmn:incoming>
      <bpmn:outgoing>SF32</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ClasserDossier" name="Classer le dossier">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF32</bpmn:incoming>
      <bpmn:outgoing>SF33</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Branche14_1">
      <bpmn:incoming>SF33</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_RecupererReponseSigneeParaphee" name="Récupérer la réponse signée et paraphée">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF28</bpmn:incoming>
      <bpmn:outgoing>SF34</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_EnregistrerDepartTransmettreCoursier" name="Enregistrer au registre de courrier départ et transmettre au coursier">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF34</bpmn:incoming>
      <bpmn:outgoing>SF35</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TransmettreCourrierDestinataire" name="Transmettre le courrier de réponse au destinataire">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF35</bpmn:incoming>
      <bpmn:outgoing>SF36</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AttendreDechargeCoursier" name="Attendre la décharge">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF36</bpmn:incoming>
      <bpmn:outgoing>SF37</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="Event_ReceptionDecharge" name="Réception de la décharge">
      <bpmn:outgoing>SF38</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_decharge" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_ClasserDecharge" name="Classer la décharge">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SF37</bpmn:incoming>
      <bpmn:incoming>SF38</bpmn:incoming>
      <bpmn:outgoing>SF39</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Branche14_2">
      <bpmn:incoming>SF39</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:textAnnotation id="Annotation_CircuitPapier">
      <bpmn:text>Point de friction structurel : circuit entièrement papier, aucune base de données centralisée, disponibilité du DG conditionne tout le délai de traitement.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_CircuitPapier" sourceRef="Task_TransmettreNavetteAgentDelegue" targetRef="Annotation_CircuitPapier" />

    <bpmn:sequenceFlow id="SF5" sourceRef="Event_ReceptionCourrierSecretariat" targetRef="Task_EnregistrerCourrierArrive" />
    <bpmn:sequenceFlow id="SF6" sourceRef="Task_EnregistrerCourrierArrive" targetRef="Task_TransmettreCourrierDG" />
    <bpmn:sequenceFlow id="SF7" sourceRef="Task_TransmettreCourrierDG" targetRef="Task_RemplirFicheEtSigner" />
    <bpmn:sequenceFlow id="SF8" sourceRef="Task_TransmettreCourrierDG" targetRef="Task_AttendreSignatureDG" />
    <bpmn:sequenceFlow id="SF9" sourceRef="Task_RemplirFicheEtSigner" targetRef="Task_ReceptionnerCourrierSigne" />
    <bpmn:sequenceFlow id="SF10" sourceRef="Task_AttendreSignatureDG" targetRef="Task_ReceptionnerCourrierSigne" />
    <bpmn:sequenceFlow id="SF11" sourceRef="Task_ReceptionnerCourrierSigne" targetRef="Task_EnregistrerRegistreTransmission" />
    <bpmn:sequenceFlow id="SF12" sourceRef="Task_EnregistrerRegistreTransmission" targetRef="Task_TransmettreNavetteAgentDelegue" />
    <bpmn:sequenceFlow id="SF13" sourceRef="Task_TransmettreNavetteAgentDelegue" targetRef="Task_AttendreReponseAgentDelegue" />
    <bpmn:sequenceFlow id="SF14" sourceRef="Task_AttendreReponseAgentDelegue" targetRef="Task_TransmettreReponseDG" />
    <bpmn:sequenceFlow id="SF15" sourceRef="Event_ReceptionReponseAgent" targetRef="Task_TransmettreReponseDG" />
    <bpmn:sequenceFlow id="SF16" sourceRef="Task_TransmettreReponseDG" targetRef="Task_ValiderOuCorriger" />
    <bpmn:sequenceFlow id="SF17" sourceRef="Task_ValiderOuCorriger" targetRef="Gateway_ValidationDG" />
    <bpmn:sequenceFlow id="SF18" name="Suggestions" sourceRef="Gateway_ValidationDG" targetRef="Task_TransmettreCorrectionAgent" />
    <bpmn:sequenceFlow id="SF19" name="Validé" sourceRef="Gateway_ValidationDG" targetRef="Gateway_ForkParapheSignature" />
    <bpmn:sequenceFlow id="SF20" sourceRef="Task_TransmettreCorrectionAgent" targetRef="EndEvent_TransmissionCorrection" />
    <bpmn:sequenceFlow id="SF21" sourceRef="Gateway_ForkParapheSignature" targetRef="Task_ParapherSignerDG" />
    <bpmn:sequenceFlow id="SF22" sourceRef="Gateway_ForkParapheSignature" targetRef="Task_AttendreParapheSignatureDG" />
    <bpmn:sequenceFlow id="SF23" sourceRef="Event_ReceptionReponseCorrigee" targetRef="Task_TransmettreReponseDG" />
    <bpmn:sequenceFlow id="SF24" sourceRef="Task_ParapherSignerDG" targetRef="Task_ReceptionnerReponseParaphee" />
    <bpmn:sequenceFlow id="SF25" sourceRef="Task_AttendreParapheSignatureDG" targetRef="Task_ReceptionnerReponseParaphee" />
    <bpmn:sequenceFlow id="SF26" sourceRef="Task_ReceptionnerReponseParaphee" targetRef="Gateway_TypeValidation" />
    <bpmn:sequenceFlow id="SF27" name="Paraphe seul + validation SG" sourceRef="Gateway_TypeValidation" targetRef="Task_TransmettreNavetteSG" />
    <bpmn:sequenceFlow id="SF28" name="Signature (dernier niveau)" sourceRef="Gateway_TypeValidation" targetRef="Task_RecupererReponseSigneeParaphee" />
    <bpmn:sequenceFlow id="SF29" sourceRef="Task_TransmettreNavetteSG" targetRef="Task_AttendreReponseSG" />
    <bpmn:sequenceFlow id="SF30" sourceRef="Task_AttendreReponseSG" targetRef="Task_RecupererCopieDossier" />
    <bpmn:sequenceFlow id="SF31" sourceRef="Event_ReceptionNotificationDossierPret" targetRef="Task_RecupererCopieDossier" />
    <bpmn:sequenceFlow id="SF32" sourceRef="Task_RecupererCopieDossier" targetRef="Task_ClasserDossier" />
