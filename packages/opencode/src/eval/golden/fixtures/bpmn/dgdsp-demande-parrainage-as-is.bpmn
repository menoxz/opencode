  <bpmn:process id="Process_AgentDelegue" isExecutable="true">
    <bpmn:intermediateCatchEvent id="Event_ReceptionCourrierAgent" name="Réception du courrier">
      <bpmn:outgoing>SFA1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_courrierAgent" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_RecupererCourrierEtSignerRegistre" name="Récupérer le courrier et signer le registre de transmission">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SFA1</bpmn:incoming>
      <bpmn:outgoing>SFA2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RedigerReponse" name="Rédiger la réponse (rapport ou courrier)">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SFA2</bpmn:incoming>
      <bpmn:outgoing>SFA3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Agent_Initial">
      <bpmn:incoming>SFA3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateCatchEvent id="Event_ReceptionDemandeCorrection" name="Réception de la demande de correction">
      <bpmn:outgoing>SFA4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_demandeCorrection" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_CorrigerReponse" name="Corriger la réponse">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>SFA4</bpmn:incoming>
      <bpmn:outgoing>SFA5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Agent_Correction">
      <bpmn:incoming>SFA5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SFA1" sourceRef="Event_ReceptionCourrierAgent" targetRef="Task_RecupererCourrierEtSignerRegistre" />
    <bpmn:sequenceFlow id="SFA2" sourceRef="Task_RecupererCourrierEtSignerRegistre" targetRef="Task_RedigerReponse" />
    <bpmn:sequenceFlow id="SFA3" sourceRef="Task_RedigerReponse" targetRef="EndEvent_Agent_Initial" />
    <bpmn:sequenceFlow id="SFA4" sourceRef="Event_ReceptionDemandeCorrection" targetRef="Task_CorrigerReponse" />
    <bpmn:sequenceFlow id="SFA5" sourceRef="Task_CorrigerReponse" targetRef="EndEvent_Agent_Correction" />
  </bpmn:process>

  <bpmn:process id="Process_Destinataire" isExecutable="true">
