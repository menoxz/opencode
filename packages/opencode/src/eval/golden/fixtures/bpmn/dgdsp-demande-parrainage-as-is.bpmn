      <bpmn:incoming>SFD1</bpmn:incoming>
      <bpmn:outgoing>SFD2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Destinataire">
      <bpmn:incoming>SFD2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SFD1" sourceRef="Event_ReceptionCourrierDestinataire" targetRef="Task_SignerDecharge" />
    <bpmn:sequenceFlow id="SFD2" sourceRef="Task_SignerDecharge" targetRef="EndEvent_Destinataire" />
  </bpmn:process>

