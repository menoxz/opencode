<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_REP_001"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="proc_rep" name="Rapport d'incident" isExecutable="true">
    <bpmn:startEvent id="s_start" name="Incident signalé" />
    <bpmn:userTask id="t_triage" name="Trier l'incident" />
    <bpmn:task id="t_fix" name="Corriger" />
    <bpmn:userTask id="t_verify" name="Vérifier" />
    <bpmn:endEvent id="e_done" name="Incident clos" />
    <bpmn:sequenceFlow id="f1" sourceRef="s_start" targetRef="t_triage" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_triage" targetRef="t_fix" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_fix" targetRef="t_verify" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_verify" targetRef="e_done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_REP_001">
    <bpmndi:BPMNPlane id="Plane_REP_001" bpmnElement="proc_rep">
      <bpmndi:BPMNShape id="s_start_di" bpmnElement="s_start">
        <dc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_triage_di" bpmnElement="t_triage">
        <dc:Bounds x="200" y="100" width="120" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_fix_di" bpmnElement="t_fix">
        <dc:Bounds x="360" y="100" width="120" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_verify_di" bpmnElement="t_verify">
        <dc:Bounds x="520" y="100" width="120" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_done_di" bpmnElement="e_done">
        <dc:Bounds x="690" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="156" y="138" />
        <di:waypoint x="200" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="320" y="138" />
        <di:waypoint x="360" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="480" y="138" />
        <di:waypoint x="520" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="640" y="138" />
        <di:waypoint x="690" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
