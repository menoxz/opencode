<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Renonciation_Reintegration" name="Renonciation &#38; Réintégration à la Nationalité Togolaise — Processus v1">
    <bpmn:participant id="part_portal" name="Portal" processRef="proc_portal" />
    <bpmn:participant id="part_xflow" name="xflow" processRef="proc_xflow" />
    <bpmn:messageFlow id="mf_submission" name="MSG_SUBMISSION_RENONCIATION_REINTEGRATION" sourceRef="p_Activity_soumission" targetRef="x_xflow_start" />
    <bpmn:messageFlow id="mf_decision_correction" name="MSG_DECISION_XFLOW" sourceRef="x_Activity_b05_notification_correction" targetRef="p_Activity_attente_instruction" />
    <bpmn:messageFlow id="mf_decision_rejet" name="MSG_DECISION_XFLOW" sourceRef="x_Activity_b08_notification_rejet" targetRef="p_Activity_attente_instruction" />
    <bpmn:messageFlow id="mf_decision_depot" name="MSG_DECISION_XFLOW" sourceRef="x_Activity_b09_notification_attente_depot" targetRef="p_Activity_attente_instruction" />
    <bpmn:messageFlow id="mf_decision_disponibilite" name="MSG_DECISION_XFLOW" sourceRef="x_Activity_b16_notification_disponibilite" targetRef="p_Activity_attente_instruction" />
    <bpmn:messageFlow id="mf_resubmission" name="MSG_RESUBMISSION_RENONCIATION_REINTEGRATION" sourceRef="p_Activity_send_correction" targetRef="x_Activity_b06_attente_ressoumission" />
    <bpmn:messageFlow id="mf_retrait" name="MSG_RETRAIT_EFFECTUE" sourceRef="p_Activity_send_retrait" targetRef="x_Activity_b16b_receive_retrait" />
  </bpmn:collaboration>
  <bpmn:message id="Message_submission" name="MSG_SUBMISSION_RENONCIATION_REINTEGRATION" />
  <bpmn:message id="Message_decision" name="MSG_DECISION_XFLOW" />
  <bpmn:message id="Message_resubmission" name="MSG_RESUBMISSION_RENONCIATION_REINTEGRATION" />
  <bpmn:message id="Message_retrait" name="MSG_RETRAIT_EFFECTUE" />
  <bpmn:process id="proc_portal" name="Portail Citoyen — Renonciation &#38; Réintégration à la Nationalité Togolaise" isExecutable="false">
    <bpmn:startEvent id="p_portal_start" name="Début de la procédure en ligne" camunda:modelerTemplate="tg.gouv.gnspd.startEvent" camunda:formKey="01KTM5AP5N2D83CM070CPKDPHV" camunda:type="external" camunda:topic="flow-start">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdStepName">Saisie de la demande de renonciation ou réintégration</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_p_portal_start_p_Activity_soumission</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="p_Activity_soumission" name="Soumettre le formulaire de renonciation/réintégration et les pièces justificatives via le portail" camunda:modelerTemplate="tg.gouv.gnspd.sendMessage" camunda:type="external" camunda:topic="flow-send-message">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdTaskKind">citizen</camunda:inputParameter>
          <camunda:inputParameter name="gnspdHandlerType">default</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskIsVisible">true</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessageRef">MSG_SUBMISSION_RENONCIATION_REINTEGRATION</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessage">${submissionData}</camunda:inputParameter>
          <camunda:inputParameter name="gnspdKafkaTopic">topic-mjl-nationalite-submission</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTargetElementType">bpmn:StartEvent</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessageDestination">peer-xflow-service-public-integration</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p_portal_start_p_Activity_soumission</bpmn:incoming>
      <bpmn:outgoing>Flow_p_Activity_soumission_p_Activity_attente_instruction</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="p_Activity_attente_instruction" name="Attendre la décision du Ministère de la Justice et de la Législation" camunda:modelerTemplate="tg.gouv.gnspd.receiveTask" messageRef="Message_decision" camunda:type="external" camunda:topic="flow-receive-task">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdTaskKind">citizen</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskIsVisible">true</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p_Activity_soumission_p_Activity_attente_instruction</bpmn:incoming>
      <bpmn:incoming>Flow_p_Activity_send_correction_p_Activity_attente_instruction</bpmn:incoming>
      <bpmn:incoming>Flow_p_Activity_depot_physique_p_Activity_attente_instruction</bpmn:incoming>
      <bpmn:incoming>Flow_p_gw_decision_portal_p_Activity_attente_instruction</bpmn:incoming>
      <bpmn:outgoing>Flow_p_Activity_attente_instruction_p_gw_decision_portal</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="p_gw_decision_portal" name="Quelle est la décision du Ministère ?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_p_Activity_attente_instruction_p_gw_decision_portal</bpmn:incoming>
      <bpmn:outgoing>Flow_p_gw_decision_portal_p_Activity_correction_portal</bpmn:outgoing>
      <bpmn:outgoing>Flow_p_gw_decision_portal_p_Activity_depot_physique</bpmn:outgoing>
      <bpmn:outgoing>Flow_p_gw_decision_portal_p_Activity_retrait_livrable</bpmn:outgoing>
      <bpmn:outgoing>Flow_p_gw_decision_portal_p_portal_end_rejet</bpmn:outgoing>
      <bpmn:outgoing>Flow_p_gw_decision_portal_p_Activity_attente_instruction</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p_Activity_correction_portal" name="Corriger les éléments du dossier signalés et préparer la resoumission" camunda:modelerTemplate="tg.gouv.gnspd.userTask" camunda:formKey="01KTTQVN71J6DKYTP20NN2N8FA" camunda:type="external" camunda:topic="flow-user-task">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdTaskKind">citizen</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskIsVisible">true</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p_gw_decision_portal_p_Activity_correction_portal</bpmn:incoming>
      <bpmn:outgoing>Flow_p_Activity_correction_portal_p_Activity_send_correction</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="p_Activity_send_correction" name="Transmettre le dossier corrigé au Ministère de la Justice via le portail" camunda:modelerTemplate="tg.gouv.gnspd.sendMessage" camunda:type="external" camunda:topic="flow-send-message">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdTaskKind">citizen</camunda:inputParameter>
          <camunda:inputParameter name="gnspdHandlerType">default</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskIsVisible">true</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessageRef">MSG_RESUBMISSION_RENONCIATION_REINTEGRATION</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessage">${correctionData}</camunda:inputParameter>
          <camunda:inputParameter name="gnspdKafkaTopic">topic-mjl-nationalite-correction</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTargetElementType">bpmn:ReceiveTask</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessageDestination">peer-xflow-service-public-integration</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p_Activity_correction_portal_p_Activity_send_correction</bpmn:incoming>
      <bpmn:outgoing>Flow_p_Activity_send_correction_p_Activity_attente_instruction</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="p_Activity_depot_physique" name="Effectuer le dépôt physique des originaux au Ministère de la Justice" camunda:modelerTemplate="tg.gouv.gnspd.userTask" camunda:formKey="01KTTQSR1KV4EQ9F5QGVQ57243" camunda:type="external" camunda:topic="flow-user-task">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdTaskKind">citizen</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskIsVisible">true</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p_gw_decision_portal_p_Activity_depot_physique</bpmn:incoming>
      <bpmn:outgoing>Flow_p_Activity_depot_physique_p_Activity_attente_instruction</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_Activity_retrait_livrable" name="Retirer le décret au Ministère de la Justice" camunda:modelerTemplate="tg.gouv.gnspd.userTask" camunda:formKey="01KTTQTBYWVCHDHS88GM5D8GM0" camunda:type="external" camunda:topic="flow-user-task">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdTaskKind">citizen</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskIsVisible">true</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p_gw_decision_portal_p_Activity_retrait_livrable</bpmn:incoming>
      <bpmn:outgoing>Flow_p_Activity_retrait_livrable_p_Activity_send_retrait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="p_Activity_send_retrait" name="Confirmer le retrait du livrable au Ministère de la Justice" camunda:modelerTemplate="tg.gouv.gnspd.sendMessage" camunda:type="external" camunda:topic="flow-send-message">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdTaskKind">citizen</camunda:inputParameter>
          <camunda:inputParameter name="gnspdHandlerType">default</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskIsVisible">true</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessageRef">MSG_RETRAIT_EFFECTUE</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessage">${retraitData}</camunda:inputParameter>
          <camunda:inputParameter name="gnspdKafkaTopic">topic-mjl-nationalite-retrait</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTargetElementType">bpmn:ReceiveTask</camunda:inputParameter>
          <camunda:inputParameter name="gnspdMessageDestination">peer-xflow-service-public-integration</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p_Activity_retrait_livrable_p_Activity_send_retrait</bpmn:incoming>
      <bpmn:outgoing>Flow_p_Activity_send_retrait_p_portal_end_success</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="p_portal_end_success" name="Procédure terminée avec succès" camunda:modelerTemplate="tg.gouv.gnspd.endEvent" camunda:type="external" camunda:topic="flow-end-event">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_p_Activity_send_retrait_p_portal_end_success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="p_portal_end_rejet" name="Procédure terminée – Demande rejetée" camunda:modelerTemplate="tg.gouv.gnspd.endEvent" camunda:type="external" camunda:topic="flow-end-event">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_p_gw_decision_portal_p_portal_end_rejet</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p_portal_start_p_Activity_soumission" sourceRef="p_portal_start" targetRef="p_Activity_soumission" />
    <bpmn:sequenceFlow id="Flow_p_Activity_soumission_p_Activity_attente_instruction" sourceRef="p_Activity_soumission" targetRef="p_Activity_attente_instruction" />
    <bpmn:sequenceFlow id="Flow_p_Activity_send_correction_p_Activity_attente_instruction" sourceRef="p_Activity_send_correction" targetRef="p_Activity_attente_instruction" />
    <bpmn:sequenceFlow id="Flow_p_Activity_depot_physique_p_Activity_attente_instruction" sourceRef="p_Activity_depot_physique" targetRef="p_Activity_attente_instruction" />
    <bpmn:sequenceFlow id="Flow_p_Activity_attente_instruction_p_gw_decision_portal" sourceRef="p_Activity_attente_instruction" targetRef="p_gw_decision_portal" />
    <bpmn:sequenceFlow id="Flow_p_gw_decision_portal_p_Activity_correction_portal" name="Corrections requises" sourceRef="p_gw_decision_portal" targetRef="p_Activity_correction_portal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Corrections requises</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_p_Activity_correction_portal_p_Activity_send_correction" sourceRef="p_Activity_correction_portal" targetRef="p_Activity_send_correction" />
    <bpmn:sequenceFlow id="Flow_p_gw_decision_portal_p_Activity_depot_physique" name="Dépôt physique obligatoire" sourceRef="p_gw_decision_portal" targetRef="p_Activity_depot_physique">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Dépôt physique obligatoire</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_p_gw_decision_portal_p_Activity_retrait_livrable" name="Livrable disponible" sourceRef="p_gw_decision_portal" targetRef="p_Activity_retrait_livrable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Livrable disponible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_p_Activity_retrait_livrable_p_Activity_send_retrait" sourceRef="p_Activity_retrait_livrable" targetRef="p_Activity_send_retrait" />
    <bpmn:sequenceFlow id="Flow_p_Activity_send_retrait_p_portal_end_success" sourceRef="p_Activity_send_retrait" targetRef="p_portal_end_success" />
    <bpmn:sequenceFlow id="Flow_p_gw_decision_portal_p_portal_end_rejet" name="Demande rejetée" sourceRef="p_gw_decision_portal" targetRef="p_portal_end_rejet">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Demande rejetée</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_p_gw_decision_portal_p_Activity_attente_instruction" name="Traitement en cours" sourceRef="p_gw_decision_portal" targetRef="p_Activity_attente_instruction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Traitement en cours</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="proc_xflow" name="XFlow Backoffice — Renonciation &#38; Réintégration à la Nationalité Togolaise" isExecutable="true">
    <bpmn:startEvent id="x_xflow_start" name="Réception de la demande de renonciation ou réintégration" camunda:modelerTemplate="tg.gouv.gnspd.startEvent" camunda:formKey="" camunda:type="external" camunda:topic="flow-start">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="development">{"AUTH":"https://dev-auth.xflow.gouv.tg","MAARCH_COURRIER":"https://dev-maarch.xflow.gouv.tg","E_SUP":"https://dev-esup.xflow.gouv.tg","NEXTCLOUD":"https://dev-nextcloud.xflow.gouv.tg","REFERENTIEL":"https://dev-referentiel.xflow.gouv.tg","PAIEMENT":"https://dev-paiement.xflow.gouv.tg","ATD_BACKEND":"http://dev-justice.xflow.gouv.tg:8383"}</camunda:inputParameter>
          <camunda:inputParameter name="sandbox">{"AUTH":"https://sandbox-auth.xflow.gouv.tg","MAARCH_COURRIER":"https://sandbox-maarch.xflow.gouv.tg","E_SUP":"https://sandbox-esup.xflow.gouv.tg","NEXTCLOUD":"https://sandbox-nextcloud.xflow.gouv.tg","REFERENTIEL":"https://sandbox-referentiel.xflow.gouv.tg","PAIEMENT":"https://sandbox-paiement.xflow.gouv.tg","ATD_BACKEND":"http://sandbox-justice.xflow.gouv.tg:8383"}</camunda:inputParameter>
          <camunda:inputParameter name="preproduction">{"AUTH":"https://preprod-auth.xflow.gouv.tg","MAARCH_COURRIER":"https://preprod-maarch.xflow.gouv.tg","E_SUP":"https://preprod-esup.xflow.gouv.tg","NEXTCLOUD":"https://preprod-nextcloud.xflow.gouv.tg","REFERENTIEL":"https://preprod-referentiel.xflow.gouv.tg","PAIEMENT":"https://preprod-paiement.xflow.gouv.tg","ATD_BACKEND":"http://preprod-justice.xflow.gouv.tg:8383"}</camunda:inputParameter>
          <camunda:inputParameter name="production">{"AUTH":"https://auth.xflow.gouv.tg","MAARCH_COURRIER":"https://maarch.xflow.gouv.tg","E_SUP":"https://esup.xflow.gouv.tg","NEXTCLOUD":"https://nextcloud.xflow.gouv.tg","REFERENTIEL":"https://referentiel.xflow.gouv.tg","PAIEMENT":"https://paiement.xflow.gouv.tg","ATD_BACKEND":"http://justice.xflow.gouv.tg:8383"}</camunda:inputParameter>
          <camunda:inputParameter name="gnspdStepName">Réception de la demande de renonciation ou réintégration</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskKind">system</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_x_xflow_start_x_b01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="x_Activity_b01_archivage_initial" name="Archiver le dossier initial dans Nextcloud" camunda:modelerTemplate="tg.gouv.gnspd.sendNotification" camunda:type="external" camunda:topic="flow-notify">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdNotifySendEmail">false</camunda:inputParameter>
          <camunda:inputParameter name="gnspdNotifySendSMS">false</camunda:inputParameter>
          <camunda:inputParameter name="gnspdNotifyInApp">true</camunda:inputParameter>
          <camunda:inputParameter name="gnspdNotifyTemplateInApp">NOTIF-001</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskKind">system</camunda:inputParameter>
          <camunda:inputParameter name="gnspdHandlerType">notification</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_x_xflow_start_x_b01</bpmn:incoming>
      <bpmn:outgoing>Flow_x_b01_x_b02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="x_Activity_b02_accuse_reception" name="Générer et envoyer l&#39;accusé de réception (NOTIF-001)" camunda:modelerTemplate="tg.gouv.gnspd.restBuilder" camunda:type="external" camunda:topic="flow-rest-builder">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdRestMethod">POST</camunda:inputParameter>
          <camunda:inputParameter name="gnspdRestDataUrl">/api/ar/generate</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTimeOutValue">30000</camunda:inputParameter>
          <camunda:inputParameter name="gnspdAcceptedHttpStatus">[200,201,204]</camunda:inputParameter>
          <camunda:inputParameter name="gnspdDataFormat">JSON</camunda:inputParameter>
          <camunda:inputParameter name="gnspdHandlerType">rest</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskKind">system</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_x_b01_x_b02</bpmn:incoming>
      <bpmn:outgoing>Flow_x_b02_x_b03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="x_Activity_b03_transmission_atd" name="Transmettre les données au back-office ATD (POST)" camunda:modelerTemplate="tg.gouv.gnspd.restBuilder" camunda:type="external" camunda:topic="flow-rest-builder">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdRestMethod">POST</camunda:inputParameter>
          <camunda:inputParameter name="gnspdRestDataUrl">/certificat-demandes/ri</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTimeOutValue">30000</camunda:inputParameter>
          <camunda:inputParameter name="gnspdAcceptedHttpStatus">[200,201]</camunda:inputParameter>
          <camunda:inputParameter name="gnspdDataFormat">JSON</camunda:inputParameter>
          <camunda:inputParameter name="gnspdHandlerType">rest</camunda:inputParameter>
          <camunda:inputParameter name="gnspdTaskKind">system</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_x_b02_x_b03</bpmn:incoming>
      <bpmn:incoming>Flow_x_b04_timer_x_b03</bpmn:incoming>
      <bpmn:outgoing>Flow_x_b03_x_b04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="x_Activity_b04_attente_asynchrone" name="Attendre le feedback du back-office ATD" camunda:modelerTemplate="tg.gouv.gnspd.receiveTask" messageRef="Message_decision" camunda:type="external" camunda:topic="flow-receive-task">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gnspdTaskKind">system</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_x_b03_x_b04</bpmn:incoming>
      <bpmn:incoming>Flow_x_b07_x_b04</bpmn:incoming>
      <bpmn:incoming>Flow_x_gw_b01_x_b04</bpmn:incoming>
      <bpmn:outgoing>Flow_x_b04_x_gw_b01</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="x_Activity_b04_timer" name="Délai de 60 min expiré" attachedToRef="x_Activity_b04_attente_asynchrone">
      <bpmn:outgoing>Flow_x_b04_timer_x_b03</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="x_gw_b01_feedback_atd" name="Quel est le feedback du back-office ATD ?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_x_b04_x_gw_b01</bpmn:incoming>
      <bpmn:outgoing>Flow_x_gw_b01_x_b05</bpmn:outgoing>
      <bpmn:outgoing>Flow_x_gw_b01_x_b08</bpmn:outgoing>
